{
	"name": "@mingull/auth",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"build": "tsdown",
		"start": "node dist/index.js",
		"start:db": "node dist/db/index.js",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
	},
	"dependencies": {
		"@mingull/lib": "workspace:*",
		"@react-email/components": "^0.5.5",
		"better-auth": "^1.3.24",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.5",
		"react": "19.1.1",
		"resend": "6.1.2",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@mingull/eslint-config": "workspace:*",
		"@mingull/typescript-config": "workspace:*",
		"@react-email/preview-server": "4.2.12",
		"@turbo/gen": "^2.5.8",
		"@types/node": "^24.6.1",
		"@types/react": "^19.1.17",
		"drizzle-kit": "^0.31.5",
		"mysql2": "^3.15.1",
		"react-email": "^4.2.12",
		"tsdown": "^0.15.6",
		"typescript": "^5.9.3"
	},
	"exports": {
		".": "./src/server.ts",
		"./client": "./src/client.ts",
		"./emails": "./src/emails/index.ts"
	}
}
